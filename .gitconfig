# This is Git's per-user configuration file.
# Personal (gmail) is the default on every box; work dirs get
# jake.s@posthog.com via the includeIf blocks below - add one per new
# work repo dir. Signing config lives in .gitconfig-signing and only
# loads on the Macs, where the key exists.
[user]
	name = jake sciotto
	email = jake.sciotto@gmail.com
[includeIf "gitdir:~/github/posthog/"]
	path = ~/.gitconfig-posthog
[includeIf "gitdir:~/github/posthog.com/"]
	path = ~/.gitconfig-posthog
[includeIf "gitdir:~/github/gtm-toolkit/"]
	path = ~/.gitconfig-posthog
[includeIf "gitdir:~/github/runbooks/"]
	path = ~/.gitconfig-posthog
[includeIf "gitdir:/Users/"]
	path = ~/.gitconfig-signing
# Machine-local git config (credential helpers, box-specific overrides).
# Never tracked; missing file is fine.
[include]
	path = ~/.gitconfig-local
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
