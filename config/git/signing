# SSH commit signing. install.sh links this file into ~/.config/git only
# where ~/.ssh/id_ed25519_signing.pub exists. PostHog rejects unsigned
# commits on every branch.
[user]
	signingkey = /Users/jakesciotto/.ssh/id_ed25519_signing.pub
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = /Users/jakesciotto/.ssh/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
