{
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true
  },
},
  "cleanupPeriodDays": 30,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-4-6"
  },
  "permissions": {
    "deny": [
      ".env",
      ".env.*",
      "**/*.key",
      "**/*.pem",
      "**/*.p12",
      "**/*.pfx",
      "**/secrets/**",
      "**/.aws/credentials",
      "**/.ssh/id_*",
      "**/*.crt",
      "**/*.cer",
      "**/password*",
      "**/token*",
      "**/.npmrc",
      "**/.pypirc",
      "**/serviceaccount*.json",
      "Bash(rm -rf:*)", 
      "Bash(rm -fr:*)"
    ],
    "ask": [
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git commit -m:*)",
      "Bash(git clean -fd:*)",
      "Bash(npm publish:*)"
    ]
  },
  "model": "claude-opus-4-6",
  "alwaysThinkingEnabled": true
}